# ─────────────────────────────────────────────────────────────
#  Telegram
# ─────────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Приватная группа модерации (бот — участник, лучше админ).
# Узнать id: добавить бота в группу и выполнить /chatid
JUDGES_CHAT_ID=-1001111111111

# Общая беседа: сюда участники присылают кружки, сюда же бот отвечает.
# Узнать id: добавить бота в беседу и выполнить /chatid.
# ВАЖНО: у @BotFather /setprivacy -> Disable, иначе бот не увидит кружки в беседе.
PARTICIPANTS_CHAT_ID=-1003333333333
# Если беседа — форум, кружки живут в своей ветке. 0 = обычная группа.
PARTICIPANTS_THREAD_ID=0

# Списки telegram_id через запятую. Первый админ получает бэкапы.
ADMIN_IDS=100000001
JUDGE_IDS=100000001,100000002

# ─────────────────────────────────────────────────────────────
#  Хранилище
# ─────────────────────────────────────────────────────────────
# АБСОЛЮТНЫЙ путь к файлу БД, вне папки с кодом
DB_PATH=/var/lib/challenge-bot/bot.db
# Куда складывать бэкапы (тоже абсолютный)
BACKUP_DIR=/var/lib/challenge-bot/backups
BACKUP_KEEP=14

# ─────────────────────────────────────────────────────────────
#  Челлендж
# ─────────────────────────────────────────────────────────────
TIMEZONE=Asia/Almaty
# Граница суток. 0 = обычные календарные сутки, приём до 00:00.
# Ненулевое значение даёт ночную фору: при 4 кружок в 01:30 идёт за вчера.
DAY_BOUNDARY_HOUR=0

CHALLENGE_START_DATE=2026-09-01
CHALLENGE_TITLE=Челлендж с кружками
# Задание дня — свободный текст, показывается в правилах и в карточке судьи
CHALLENGE_TASK=планка на прямых руках или на локтях, ровно минуту без остановки
MIN_DURATION_SEC=58
MAX_DURATION_SEC=600

# ─────────────────────────────────────────────────────────────
#  Режим работы
# ─────────────────────────────────────────────────────────────
# true — отдельный тестовый челлендж (is_test=true), доступны /simulate_day и /wipe_test.
# Переключение в бой: TEST_MODE=false + перезапуск. Миграции не нужны.
TEST_MODE=true
# Старт тестового челленджа. Пусто — дата первого запуска.
TEST_START_DATE=

# ─────────────────────────────────────────────────────────────
#  Слово дня
# ─────────────────────────────────────────────────────────────
DAILY_CODE_ENABLED=false
WORDS_FILE=data/words.txt
QUOTES_FILE=data/quotes.json
# Не повторять слово в пределах N дней
CODE_NO_REPEAT_DAYS=30

# ─────────────────────────────────────────────────────────────
#  Шум
# ─────────────────────────────────────────────────────────────
# Реакции на кружок вместо сообщений «принято» (меньше спама в беседе).
# Если в беседе ограничен набор реакций, бот сам откатится на текст.
USE_REACTIONS=true

# ─────────────────────────────────────────────────────────────
#  Лимиты и окна
# ─────────────────────────────────────────────────────────────
# Минимальный интервал между кружками от одного участника, сек
SUBMISSION_COOLDOWN_SEC=30
# Флаг «сдача в последние N минут дня»
LAST_MINUTES_FLAG=15

# ─────────────────────────────────────────────────────────────
#  Клуб по умолчанию
# ─────────────────────────────────────────────────────────────
# Значения ниже используются только для первого клуба: при первом запуске
# из них собирается строка в таблице clubs. Дальше бот живёт по базе, а
# новые группы заводятся командой /newclub прямо в них.
CLUB_NAME=Клуб
# Чат клуба, куда публикуются тренировки и сбор участников.
# 0 = ещё не заведён: тренировки создаются, но не публикуются.
TRAININGS_CHAT_ID=0
TRAININGS_THREAD_ID=0
# За сколько часов до старта напоминать тем, кто нажал «Буду».
# 24,3 = за сутки и за три часа. Любые значения, список — не два флага.
TRAINING_REMINDERS=24,3
# Бот сам готовит черновик на регулярные дни по последней такой тренировке
TRAINING_AUTO_DRAFT=true
TRAINING_DRAFT_WEEKDAYS=tue,thu

# Погода на час тренировки — Open-Meteo, бесплатно и без ключа.
# Координаты по умолчанию — Алматы.
WEATHER_ENABLED=true
WEATHER_LAT=43.2389
WEATHER_LON=76.8897

# Через сколько часов после тренировки убирать скриншоты отчётов
# и ответы бота из ветки. 0 = не убирать. Пост тренировки остаётся всегда.
# Сбор участников неанонимным опросом Telegram: видно, кто как ответил.
# false — вернутся инлайн-кнопки со счётчиком.
USE_POLL=true

CHECKIN_CLEANUP_HOURS=0

# Отдельный топик под отчёты со Стравы. Там реплай на пост тренировки
# не нужен: занятие подбирается по времени.
CHECKINS_CHAT_ID=0
CHECKINS_THREAD_ID=0
# Сколько часов после начала тренировки принимаем по ней отчёты.
# Это и есть защита от случайных фото: нет прошедшей тренировки — нет зачёта.
CHECKIN_WINDOW_HOURS=48

LOG_LEVEL=INFO
